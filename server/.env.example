# Server
PORT=4000
NODE_ENV=development

# Data mode: "memory" (default, no DB required — recommended for the SIH demo)
# or "mongo" (connects to MongoDB using MONGO_URI and persists seed data there)
DATA_MODE=memory

# MongoDB (only used when DATA_MODE=mongo)
MONGO_URI=mongodb://localhost:27017/disaster_relocation

# Auth
JWT_SECRET=change_this_demo_secret

# AI Copilot (Anthropic API)
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
